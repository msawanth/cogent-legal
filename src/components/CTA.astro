---
import StoreBadges from './StoreBadges.astro';
---

<section class="relative overflow-hidden px-6 py-28 text-center sm:py-36">
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div
      class="absolute top-1/2 left-1/2 h-[50vh] w-[80vw] -translate-x-1/2 -translate-y-1/2 rounded-full opacity-40 blur-3xl"
      style="background: radial-gradient(circle, rgba(94,92,230,0.25), transparent 60%);"
    >
    </div>
  </div>

  <h2 class="reveal mx-auto max-w-2xl text-balance text-4xl font-bold sm:text-6xl">
    Keep more of your money, time, and focus.
  </h2>
  <p class="reveal mx-auto mt-5 max-w-xl text-white/65 sm:text-lg">
    Cogent is ready for the next urge — the next impulse buy, the next rushed
    “yes.” Get it now on iPhone.
  </p>

  <StoreBadges class="reveal mt-9" center />
</section>
