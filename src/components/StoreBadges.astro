---
import { APP_STORE_URL } from '../lib/site';

interface Props {
  /** extra classes on the wrapping row */
  class?: string;
  /** center the row (used in the closing CTA) */
  center?: boolean;
}
const { class: className = '', center = false } = Astro.props;

// Unique per instance — the component renders more than once per page, so a
// shared gradient id would produce invalid duplicate IDs.
const gpId = `cogent-gp-${Math.random().toString(36).slice(2, 8)}`;
---

<div
  class:list={[
    'flex flex-col items-center gap-4 sm:flex-row',
    center && 'sm:justify-center',
    className,
  ]}
>
  <!-- App Store — live -->
  <a
    href={APP_STORE_URL}
    target="_blank"
    rel="noopener"
    aria-label="Download Cogent on the App Store"
    data-magnetic="0.25"
    class="inline-block rounded-[9px] transition-transform hover:-translate-y-0.5"
  >
    <svg viewBox="0 0 120 40" role="img" aria-label="Download on the App Store" class="h-[52px] w-auto">
      <rect x="0.5" y="0.5" width="119" height="39" rx="6.5" fill="#000" stroke="rgba(255,255,255,0.3)"></rect>
      <g transform="translate(9.5 8.4)" fill="#fff">
        <path d="M17.543 12.607c-.02-2.29 1.87-3.39 1.955-3.445-1.065-1.558-2.724-1.772-3.312-1.796-1.41-.143-2.75.83-3.465.83-.713 0-1.813-.81-2.982-.788-1.535.023-2.95.892-3.74 2.266-1.593 2.762-.408 6.85 1.143 9.095.76 1.099 1.667 2.334 2.855 2.29 1.145-.046 1.577-.74 2.96-.74 1.383 0 1.772.74 2.983.717 1.232-.02 2.014-1.12 2.77-2.225.873-1.276 1.232-2.512 1.253-2.576-.027-.013-2.404-.922-2.428-3.66zM15.28 5.09c.63-.766 1.056-1.83.94-2.89-.91.037-2.01.605-2.662 1.37-.585.68-1.097 1.763-.96 2.804 1.016.078 2.052-.517 2.682-1.284z"
        ></path>
      </g>
      <text x="40" y="16" fill="#fff" font-family="system-ui, sans-serif" font-size="7" font-weight="400">Download on the</text>
      <text x="40" y="31" fill="#fff" font-family="system-ui, sans-serif" font-size="15" font-weight="600" letter-spacing="-0.3">App Store</text>
    </svg>
  </a>

  <!-- Google Play — coming soon (not yet a live listing) -->
  <div class="relative inline-block opacity-60" aria-label="Cogent is coming soon on Google Play">
    <svg viewBox="0 0 135 40" role="img" aria-label="Get it on Google Play" class="h-[52px] w-auto">
      <defs>
        <linearGradient id={gpId} x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#00C3FF"></stop>
          <stop offset="0.36" stop-color="#00E36A"></stop>
          <stop offset="0.7" stop-color="#FFD400"></stop>
          <stop offset="1" stop-color="#FF3B30"></stop>
        </linearGradient>
      </defs>
      <rect x="0.5" y="0.5" width="134" height="39" rx="6.5" fill="#000" stroke="rgba(255,255,255,0.3)"></rect>
      <g transform="translate(11 9.5) scale(0.82)">
        <path fill={`url(#${gpId})`} d="M22.018 13.298l-3.919 2.218-3.515-3.493 3.543-3.521 3.891 2.202a1.49 1.49 0 0 1 0 2.594zM1.337.924a1.486 1.486 0 0 0-.112.568v21.017c0 .217.045.419.124.6l11.155-11.087L1.337.924zm12.207 10.065l3.258-3.238L3.45.195a1.466 1.466 0 0 0-.946-.179l11.04 10.973zm0 2.067l-11 10.933c.298.036.612-.016.906-.183l13.324-7.54-3.23-3.21z"
        ></path>
      </g>
      <text x="42" y="16" fill="#fff" font-family="system-ui, sans-serif" font-size="6.5" font-weight="500" letter-spacing="1">GET IT ON</text>
      <text x="42" y="31" fill="#fff" font-family="system-ui, sans-serif" font-size="15" font-weight="600" letter-spacing="-0.2">Google Play</text>
    </svg>
    <span
      class="absolute -top-2 -right-2 rounded-full border border-white/15 bg-bg px-2 py-0.5 text-[10px] font-semibold tracking-wide text-white/70"
    >
      Soon
    </span>
  </div>
</div>
