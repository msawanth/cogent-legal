---
const stages = [
  {
    n: '01',
    tag: 'Capture',
    name: 'Brain dump',
    color: '#FF453A',
    body: 'The moment the urge hits, tell Cogent — type it or just say it out loud. Getting it out of your head is where the better decision starts.',
  },
  {
    n: '02',
    tag: 'Name it',
    name: 'Spot the trap',
    color: '#FF9F0A',
    body: 'Cogent tells you why the urge feels so strong — a sale that’s about to end, the fear of missing out, or the time you’ve already put in. Once you see the reason, saying no gets a lot easier.',
  },
  {
    n: '03',
    tag: 'Wait it out',
    name: 'Cool off',
    color: '#3B82F6',
    body: 'The urge goes on hold — a short wait for something small, longer for a big, hard-to-undo choice. More often than not, it just fades before the timer’s up.',
  },
  {
    n: '04',
    tag: 'Think it over',
    name: 'Talk it through',
    color: '#5E5CE6',
    body: 'When the wait is up, Cogent asks the honest questions a good friend would — the ones that help you tell whether you’ll actually be glad you did it.',
  },
  {
    n: '05',
    tag: 'Track the win',
    name: 'See it pay off',
    color: '#30D158',
    body: 'Later, you mark how it turned out. Every smart call lifts your score and adds to your running total of money and time saved.',
  },
];
---

<section id="how" class="relative px-6 py-24 sm:py-32">
  <div class="mx-auto max-w-3xl text-center">
    <p class="reveal text-sm font-semibold uppercase tracking-[0.3em] text-white/40">
      How it works
    </p>
    <h2 class="reveal mx-auto mt-4 max-w-2xl text-balance text-center text-3xl font-bold sm:text-5xl">
      From urge to smart call, in five steps.
    </h2>
  </div>

  <div class="mx-auto mt-10 max-w-6xl md:grid md:grid-cols-[1fr_1.1fr] md:gap-14">
    <!-- Sticky "impulse cooling" scene (desktop). Falls back to the CSS glow
         orb + static label under reduced motion / no JS. -->
    <div class="hidden md:block">
      <div class="sticky top-0 flex h-dvh items-center justify-center">
        <div class="loop-visual relative aspect-square w-full max-w-md">
          <canvas class="loop-canvas absolute inset-0 h-full w-full"></canvas>
          <div class="pointer-events-none absolute inset-0 grid place-items-center text-center">
            <div>
              <div
                class="loop-label-tag text-[11px] font-bold uppercase tracking-[0.25em]"
                style={`color:${stages[0].color}`}
              >
                {stages[0].tag}
              </div>
              <div class="loop-label-name mt-1 text-2xl font-semibold text-white/90">
                {stages[0].name}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Stages (always present + readable; the scene is pure enhancement). -->
    <ol class="relative">
      <div
        class="absolute top-2 bottom-2 left-[19px] w-px bg-linear-to-b from-red via-blue to-green opacity-30 sm:left-[23px]"
        aria-hidden="true"
      >
      </div>
      {
        stages.map((s, i) => (
          <li
            class="loop-stage relative flex items-start gap-5 py-8 sm:gap-7 md:min-h-[60vh] md:items-center md:py-0"
            data-index={i}
            data-tag={s.tag}
            data-name={s.name}
            data-color={s.color}
          >
            <div
              class="relative z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full border bg-bg text-sm font-bold sm:h-12 sm:w-12"
              style={`border-color:${s.color}; color:${s.color}; box-shadow:0 0 24px ${s.color}55`}
            >
              {s.n}
            </div>
            <div>
              <span
                class="text-xs font-bold uppercase tracking-[0.25em]"
                style={`color:${s.color}`}
              >
                {s.tag}
              </span>
              <h3 class="mt-1 text-xl font-semibold sm:text-2xl">{s.name}</h3>
              <p class="mt-2 leading-relaxed text-white/60">{s.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script>
  const section = document.getElementById('how');
  const canvas = section?.querySelector<HTMLCanvasElement>('.loop-canvas');
  const stageEls = section
    ? Array.from(section.querySelectorAll<HTMLElement>('.loop-stage'))
    : [];
  const labelTag = section?.querySelector<HTMLElement>('.loop-label-tag');
  const labelName = section?.querySelector<HTMLElement>('.loop-label-name');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const desktop = window.matchMedia('(min-width: 768px)');

  const clamp = (v: number, a: number, b: number) => Math.max(a, Math.min(b, v));
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
  function hexToRgb(hex: string): [number, number, number] {
    const m = hex.replace('#', '');
    const s = m.length === 3 ? m.split('').map((c) => c + c).join('') : m;
    const n = parseInt(s, 16);
    return [(n >> 16) & 255, (n >> 8) & 255, n & 255];
  }

  // Init when the desktop media query matches — now, or later if the viewport
  // starts narrow (or unsized) and crosses 768px afterwards.
  let initialized = false;
  function maybeInit() {
    if (initialized || reduce || !desktop.matches) return;
    if (!section || !canvas || !labelTag || !labelName || !stageEls.length) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    initialized = true;
    initScene(section, canvas, ctx, stageEls, labelTag, labelName);
  }
  maybeInit();
  desktop.addEventListener('change', maybeInit);

  function initScene(
    section: HTMLElement,
    canvas: HTMLCanvasElement,
    ctx: CanvasRenderingContext2D,
    stageEls: HTMLElement[],
    labelTag: HTMLElement,
    labelName: HTMLElement,
  ) {
    const TAU = Math.PI * 2;
    const stages = stageEls.map((el) => ({
      tag: el.dataset.tag || '',
      name: el.dataset.name || '',
      color: hexToRgb(el.dataset.color || '#5e5ce6'),
    }));

    const particles = Array.from({ length: 300 }, () => ({
      ang: Math.random() * TAU,
      rad: 0.22 + Math.random() * 0.72,
      seed: Math.random() * TAU,
      spd: 0.25 + Math.random() * 0.85,
      size: 0.7 + Math.random() * 1.7,
      alpha: 0.35 + Math.random() * 0.5,
    }));

    // Cached background gradient — rebuilt only when the colour or canvas
    // geometry actually changes, not every frame.
    let bgKey = -1;
    let bgGrad: CanvasGradient | null = null;

    let w = 0;
    let h = 0;
    function resize() {
      const r = canvas.getBoundingClientRect();
      // 2D canvas doesn't need retina-crisp particles; 1.5x is indistinguishable
      // for soft glows and ~44% cheaper per frame than 2x.
      const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      w = r.width;
      h = r.height;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      bgKey = -1;
    }
    resize();
    window.addEventListener('resize', resize);

    // Pre-rendered particle sprite (soft radial blob), cached per quantized
    // colour. Blitting one image per particle is far cheaper — and softer —
    // than filling two gradient paths per particle every frame.
    const sprites = new Map<number, HTMLCanvasElement>();
    function sprite(r: number, g: number, b: number): HTMLCanvasElement {
      const key = ((r >> 3) << 10) | ((g >> 3) << 5) | (b >> 3);
      let s = sprites.get(key);
      if (!s) {
        s = document.createElement('canvas');
        s.width = s.height = 64;
        const sc = s.getContext('2d')!;
        const grad = sc.createRadialGradient(32, 32, 0, 32, 32, 32);
        grad.addColorStop(0, `rgba(${r},${g},${b},1)`);
        grad.addColorStop(0.3, `rgba(${r},${g},${b},0.55)`);
        grad.addColorStop(1, `rgba(${r},${g},${b},0)`);
        sc.fillStyle = grad;
        sc.fillRect(0, 0, 64, 64);
        if (sprites.size > 48) sprites.delete(sprites.keys().next().value!);
        sprites.set(key, s);
      }
      return s;
    }

    function colorAt(p: number): [number, number, number] {
      const n = stages.length - 1;
      const x = clamp(p, 0, 1) * n;
      const i = Math.min(Math.floor(x), n - 1);
      const t = x - i;
      const a = stages[i].color;
      const b = stages[i + 1].color;
      return [lerp(a[0], b[0], t), lerp(a[1], b[1], t), lerp(a[2], b[2], t)];
    }

    let lastIdx = -1;
    function setActive(idx: number) {
      stageEls.forEach((el, i) => {
        const d = Math.abs(i - idx);
        el.style.opacity = d === 0 ? '1' : d === 1 ? '0.55' : '0.3';
      });
      const s = stages[idx];
      labelTag.textContent = s.tag;
      labelTag.style.color = `rgb(${s.color[0] | 0},${s.color[1] | 0},${s.color[2] | 0})`;
      labelName.textContent = s.name;
    }

    function draw(t: number, p: number) {
      ctx.clearRect(0, 0, w, h);
      const cx = w / 2;
      const cy = h / 2;
      const maxR = Math.min(w, h) * 0.42;
      const calm = clamp(p, 0, 1);
      const jitter = 1 - calm;
      const [cr, cg, cb] = colorAt(p);
      const rc = cr | 0;
      const gc = cg | 0;
      const bc = cb | 0;

      const key = ((rc >> 3) << 10) | ((gc >> 3) << 5) | (bc >> 3);
      if (key !== bgKey || !bgGrad) {
        bgGrad = ctx.createRadialGradient(cx, cy, 0, cx, cy, maxR * 1.25);
        bgGrad.addColorStop(0, `rgba(${rc},${gc},${bc},0.15)`);
        bgGrad.addColorStop(1, 'rgba(0,0,0,0)');
        bgKey = key;
      }
      ctx.fillStyle = bgGrad;
      ctx.fillRect(0, 0, w, h);

      const blob = sprite(rc, gc, bc);
      ctx.globalCompositeOperation = 'lighter';
      for (const pt of particles) {
        const angle = pt.ang + t * pt.spd * (0.25 + jitter * 1.7);
        const noise =
          Math.sin(t * 1.6 * pt.spd + pt.seed) * 0.5 +
          Math.sin(t * 3.1 + pt.seed * 1.7) * 0.3;
        const r = maxR * (pt.rad + noise * 0.28 * jitter);
        const x = cx + Math.cos(angle) * r;
        const y = cy + Math.sin(angle) * r;
        const half = pt.size * (1 + calm * 0.5) * 3.2;
        ctx.globalAlpha = pt.alpha;
        ctx.drawImage(blob, x - half, y - half, half * 2, half * 2);
      }
      ctx.globalAlpha = 1;
      ctx.globalCompositeOperation = 'source-over';
    }

    // The rAF loop only runs while the section is near the viewport (started a
    // little early via rootMargin so there's no cold-start hitch on entry), and
    // scroll progress is eased so colour/motion glide instead of stepping with
    // each scroll tick.
    let running = false;
    let rafId = 0;
    let lastNow = 0;
    let pSmooth = 0;

    function frame(now: number) {
      if (!running) return;
      const dt = Math.min((now - lastNow) / 1000, 0.05);
      lastNow = now;

      const rect = section.getBoundingClientRect();
      const total = section.offsetHeight - window.innerHeight;
      const p = total > 0 ? clamp(-rect.top, 0, total) / total : 0;
      pSmooth += (p - pSmooth) * (1 - Math.exp(-6 * dt));

      const idx = clamp(Math.floor(p * stages.length), 0, stages.length - 1);
      if (idx !== lastIdx) {
        setActive(idx);
        lastIdx = idx;
      }

      if (rect.bottom > 0 && rect.top < window.innerHeight) draw(now / 1000, pSmooth);
      rafId = requestAnimationFrame(frame);
    }

    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting && !running) {
          running = true;
          lastNow = performance.now();
          rafId = requestAnimationFrame(frame);
        } else if (!entry.isIntersecting && running) {
          running = false;
          cancelAnimationFrame(rafId);
        }
      },
      { rootMargin: '300px 0px' },
    );
    io.observe(section);

    setActive(0);
  }
</script>
