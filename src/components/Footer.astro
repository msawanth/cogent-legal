  <nav class="mt-6 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm">
    <a href="/privacy.html" class="text-white/60 transition-colors hover:text-white">
      Privacy Policy
    </a>
    <a href="/terms.html" class="text-white/60 transition-colors hover:text-white">
