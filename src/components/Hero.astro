---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import HeroCanvas from './react/HeroCanvas.tsx';
import StoreBadges from './StoreBadges.astro';
---

<section
  class="relative flex min-h-dvh flex-col items-center justify-center overflow-hidden px-6 py-24 text-center"
>
  <!-- Ambient duality glows: warm (impulse) at left, cool (logic) at right. -->
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div
      class="pulse-glow absolute -top-1/4 left-1/2 h-[70vh] w-[70vh] -translate-x-1/2 rounded-full blur-3xl"
      style="background: radial-gradient(circle, rgba(94,92,230,0.20), transparent 62%);"
    >
    </div>
    <div
      class="absolute top-1/3 left-0 h-[42vh] w-[42vh] rounded-full opacity-40 blur-3xl"
      style="background: radial-gradient(circle, rgba(255,69,58,0.14), transparent 65%);"
    >
    </div>
    <div
      class="absolute top-1/3 right-0 h-[42vh] w-[42vh] rounded-full opacity-40 blur-3xl"
      style="background: radial-gradient(circle, rgba(59,130,246,0.16), transparent 65%);"
    >
    </div>
  </div>

  <!-- Full-bleed 3D brain (behind the copy). #hero-visual is the WebGL mount hook. -->
  <div id="hero-visual" class="absolute inset-0 z-0">
    <HeroCanvas client:only="react" />
  </div>

  <!-- Static brand mark, top-left. -->
  <div class="absolute top-6 left-6 z-20 flex items-center gap-3 sm:top-8 sm:left-8">
    <Image
      src={logo}
      alt="Cogent logo — a brain split between impulse and logic"
      width={80}
      height={80}
      class="h-9 w-9 rounded-xl border border-white/10 sm:h-10 sm:w-10"
    />
    <span class="text-base font-semibold tracking-tight text-white/90">Cogent</span>
  </div>

  <!-- Legibility scrim over the particles, beneath the copy. -->
  <div
    class="pointer-events-none absolute inset-0 z-[1]"
    style="background: radial-gradient(60% 52% at 50% 46%, rgba(13,15,20,0.74) 0%, rgba(13,15,20,0.34) 46%, rgba(13,15,20,0) 74%);"
  >
  </div>

  <!-- Copy overlay. pointer-events pass through to the canvas except on controls,
       so the particles react to the cursor across the whole hero. -->
  <div class="pointer-events-none relative z-10 flex flex-col items-center">
    <h1
      class="reveal max-w-3xl text-balance text-4xl font-bold leading-[1.05] tracking-tight sm:text-6xl md:text-7xl"
      style="text-shadow: 0 2px 40px rgba(0,0,0,0.55);"
    >
      Beat the urge before it costs you.
    </h1>
    <p
      class="reveal mt-6 max-w-xl text-base leading-relaxed text-white/70 sm:text-lg"
      style="text-shadow: 0 1px 22px rgba(0,0,0,0.6);"
    >
      Cogent is your AI decision coach. When the urge to buy, quit, or say “yes”
      hits, it helps you stop, see what’s really behind it, and make the call you
      won’t regret — so you keep more of your money, time, and focus.
    </p>

    <div class="reveal pointer-events-auto mt-10">
      <StoreBadges />
    </div>
  </div>

  <a
    href="#how"
    aria-label="See how it works"
    class="reveal pointer-events-auto absolute bottom-8 left-1/2 z-10 -translate-x-1/2 text-white/35 transition-colors hover:text-white/70"
  >
    <svg
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="float"
    >
      <path d="M12 5v14M5 12l7 7 7-7"></path>
    </svg>
  </a>
</section>
